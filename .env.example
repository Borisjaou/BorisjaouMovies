# Адрес сайта: ссылки «Поделиться», canonical, sitemap, OG-картинки.
# На Vercel без своего домена можно не задавать — возьмётся основной *.vercel.app
NEXT_PUBLIC_SITE_URL=https://borisjaou.app

# Auth.js: секрет для подписи сессий. Сгенерировать: npx auth secret
AUTH_SECRET=

# Вход через Google (console.cloud.google.com → OAuth client, redirect URI:
# http://localhost:3000/api/auth/callback/google). Без них кнопка Google покажет «пока не настроен».
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Почты администраторов через запятую — роль admin выдаётся при регистрации / первом входе.
# Регистрация закрыта для всех остальных: форма — только по ссылке /login?mode=register
ADMIN_EMAILS=

# База данных.
# Разработка — SQLite, файл создаётся сам:           DATABASE_URL=file:./data/dev.db
# Продакшен — PostgreSQL:  DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/borisjaou?schema=public
# После смены базы: npm run db:generate (клиент Prisma собирается под провайдера из DATABASE_URL)
DATABASE_URL=file:./data/dev.db
# Только PostgreSQL через пулер (Neon, Supabase): прямое подключение для миграций (prisma migrate deploy)
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Хранилище постеров:
#   local    — public/uploads (разработка, сервер с постоянным диском)
#   supabase — Supabase Storage (Vercel: диск там только для чтения)
STORAGE_DRIVER=local
# Для STORAGE_DRIVER=supabase (Project Settings → API). Ключ service_role — секрет, только на сервере
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=posters

# Автозаполнение формы фильма по ссылке (админка). Без ключа — понятная ошибка в форме.
# Кинопоиск: ключ из личного кабинета kinopoiskapiunofficial.tech
# KINOPOISK_API_KEY=
# TMDB (ссылки themoviedb.org и imdb.com): ключ API или токен доступа на чтение (eyJ…) с themoviedb.org
# TMDB_API_KEY=
